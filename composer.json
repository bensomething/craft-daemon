{
    "name": "bensomething/craft-daemon",
    "description": "Play Doom engine games in the Craft control panel. An explicit novelty, engineered like it isn't.",
    "type": "craft-plugin",
    "license": "MIT AND GPL-2.0-or-later",
    "keywords": [
        "craft",
        "cms",
        "craftcms",
        "plugin",
        "doom",
        "prboom",
        "freedoom",
        "wasm",
        "webassembly",
        "novelty"
    ],
    "support": {
        "issues": "https://github.com/bensomething/craft-daemon/issues",
        "source": "https://github.com/bensomething/craft-daemon"
    },
    "require": {
        "php": "^8.2",
        "ext-zip": "*",
        "craftcms/cms": "^5.10"
    },
    "require-dev": {
        "craftcms/ecs": "dev-main",
        "craftcms/phpstan": "dev-main",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "bensomething\\daemon\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "bensomething\\daemon\\tests\\": "tests/"
        }
    },
    "extra": {
        "handle": "daemon",
        "name": "Daemon",
        "developer": "Ben Smith",
        "developerUrl": "https://bensomething.com",
        "documentationUrl": "https://github.com/bensomething/craft-daemon",
        "changelogUrl": "https://raw.githubusercontent.com/bensomething/craft-daemon/develop/CHANGELOG.md",
        "class": "bensomething\\daemon\\Plugin"
    },
    "config": {
        "allow-plugins": {
            "yiisoft/yii2-composer": true,
            "craftcms/plugin-installer": true
        }
    },
    "scripts": {
        "check-cs": "ecs check --ansi",
        "fix-cs": "ecs check --ansi --fix",
        "phpstan": "phpstan --memory-limit=1G",
        "test": "phpunit"
    }
}
