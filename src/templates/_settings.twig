{% import '_includes/forms.twig' as forms %}

{% if not engine.isInstalled() %}
    <p class="warning">
        {{ 'The engine is missing from this install, so the section will not run. See the plugin README.'|t('daemon') }}
    </p>
{% endif %}

{% set available = wads.getAvailableWads() %}
{% set storageDir = wads.getStorageDir() %}

<h2 class="daemon-heading">{{ 'WADs'|t('daemon') }}</h2>

{# Swapped in place after a download. By class, not id, for the reason below. #}
<div class="daemon-wad-list">
    {% include 'daemon/_wads' with {
        available: available,
        settings: settings,
    } only %}
</div>

{# The buttons live on the Utilities screen now: this one is rendered through
   Html::disableInputs() whenever allowAdminChanges is off, which would disable
   them and throw away the JavaScript that drives them. #}
<p class="light daemon-fetch-note">
    <a class="go" href="{{ url('utilities/daemon') }}">{{ 'Download Freedoom or the Doom shareware episode'|t('daemon') }}</a>
</p>

{# Named rather than quietly skipped: a WAD in a search directory is somebody
   expecting it to show up. #}
{% set unsupported = wads.getUnsupportedWads() %}

{% if unsupported %}
    <p class="light daemon-fetch-note">
        {{ 'Found but not offered. These are Doom engine games, but the engine here runs Doom itself and nothing else.'|t('daemon') }}
    </p>

    <ul class="light daemon-unsupported">
        {% for path, game in unsupported %}
            <li><code>{{ path }}</code> ({{ game }})</li>
        {% endfor %}
    </ul>
{% endif %}

{{ forms.autosuggestField({
    label: 'WAD directory'|t('daemon'),
    instructions: 'Also look for WADs here, alongside {dir}. An absolute path, an @alias, or a $ENVIRONMENT_VARIABLE. Everything found is listed in the Game menu, and this directory is searched first, so the first WAD in it becomes the default.'|t('daemon', {dir: storageDir}),
    warning: wadDirMissing ? '{dir} does not exist, so nothing is being loaded from it.'|t('daemon', {dir: wadDir}),
    id: 'wadDir',
    name: 'wadDir',
    suggestEnvVars: true,
    suggestAliases: true,
    value: settings.wadDir,
    errors: settings.getErrors('wadDir'),
}) }}

<hr>

{{ forms.lightswitchField({
    label: 'Keep savegames'|t('daemon'),
    instructions: 'Copy savegames into Craft as the game writes them, and add a **Saves** menu to the Daemon screen. Saving from the game\'s own Esc menu is what triggers it. The engine already keeps its own copy in the browser, which is lost the moment site data is cleared. This version lives in storage and follows the player to another machine. Off by default: leaving the page mid-game warns you either way.'|t('daemon'),
    id: 'autosave',
    name: 'autosave',
    on: settings.autosave,
    errors: settings.getErrors('autosave'),
}) }}

{{ forms.lightswitchField({
    label: 'Pointer lock'|t('daemon'),
    instructions: 'Capture the mouse for mouselook when the canvas is clicked. Turn this off for keyboard-only play.'|t('daemon'),
    id: 'pointerLock',
    name: 'pointerLock',
    on: settings.pointerLock,
    errors: settings.getErrors('pointerLock'),
}) }}

{{ forms.lightswitchField({
    label: 'Leaderboard'|t('daemon'),
    instructions: 'Keep a record of every level completed, and add a **Leaderboard** button to the Daemon screen showing the fastest time and the most kills, items and secrets for each level, across everyone who plays. Off stops the engine being asked for stats at all. Two things it cannot know: the skill a time was set on, because the engine does not write it down, and whether anyone typed IDCLEV.'|t('daemon'),
    id: 'leaderboard',
    name: 'leaderboard',
    on: settings.leaderboard,
    errors: settings.getErrors('leaderboard'),
}) }}

{% css %}
    /* Not :first-child. Craft's plugin settings template emits three hidden
       inputs before this template's output, so the heading is never the first
       element child and neither this rule nor Craft's own h2:first-child reset
       ever matched. Zero it outright, and hand the 14px back only when the
       engine warning is above it and needs the separation. */
    .daemon-heading { margin-top: 0; }
    .warning + .daemon-heading { margin-top: 14px; }
    .daemon-wad-table { margin-top: 12px; }
    /* Craft's CP strips list markers, and this one reads as a list of files
       rather than a paragraph, so it asks for them back. */
    .daemon-unsupported { margin: 0 0 14px; padding-left: 18px; list-style: disc; }
    .daemon-unsupported li { margin-top: 2px; }
    /* Fixed rather than a percentage: without a width of its own the name
       column collapses to whatever the paths leave it, which on a long storage
       path is nothing. min-width as well as width, because the table lays out
       automatically and treats width alone as a suggestion.

       Keyed on a class rather than a position, so moving a column around does
       not silently move the width and the rule onto a different one. */
    .daemon-wad-table .daemon-col-name { width: 200px; }
    .daemon-wad-table .daemon-name-cell {
        width: 200px;
        min-width: 200px;
        border-right: 1px solid var(--hairline-color, #e3e5e8);
    }
    .daemon-wad-table .heading-cell { font-weight: normal; }
    .daemon-wad-table code { word-break: break-all; }
    .daemon-wad-table .checkbox-cell { text-align: center; vertical-align: middle; }
    /* Tighter rows. Craft sizes the editable table for typing in; this one is
       a fixed list of files that only takes a name, so it can afford to be read
       at a glance instead. The textarea has to come down with the cells: at 7px
       of block padding on a 20px line it is the tallest thing in the row, and
       trimming the cells on their own would move nothing. */
    table.daemon-wad-table tbody tr th,
    table.daemon-wad-table thead tr th,
    table.daemon-wad-table tbody tr td.checkbox-cell { padding-block: 4px; }
    .daemon-wad-table .daemon-name-cell textarea { padding-block: 4px; }

    .daemon-fetch-note { margin-top: 24px; }
{% endcss %}
