{% import '_includes/forms.twig' as forms %}

{% if not engine.isInstalled() %}
    <p class="warning">
        {{ 'The engine is missing from this install, so the section will not run. See the plugin README.'|t('doom') }}
    </p>
{% endif %}

{% set found = wads.getStoredWads() %}
{% set storageDir = wads.getStorageDir() %}

<h2 class="doom-heading">{{ 'WADs'|t('doom') }}</h2>

{% if found %}
    <p class="light">{{ 'Found in {dir}. The first one is used unless you set a path below.'|t('doom', {dir: storageDir}) }}</p>

    <ul class="bullets doom-wad-list">
        {% for path in found %}
            <li><code>{{ path }}</code></li>
        {% endfor %}
    </ul>
{% else %}
    <p class="light">
        {{ 'No WADs found yet. Freedoom is a free, BSD licensed replacement for the id WADs, and it is all this needs to run.'|t('doom') }}
    </p>
{% endif %}

{# Hooked by class, not id. This template's output is wrapped in
   View::namespaceInputs(), which rewrites ids (doom-fetch becomes
   settings-doom-fetch) but leaves classes alone, while the JS registered by
   {% js %} is not namespaced at all. An id selector here silently matches
   nothing. #}
<div class="doom-fetch">
    <div class="buttons">
        <button type="button" class="btn doom-fetch-btn" data-icon="download">
            {{ found ? 'Download Freedoom again'|t('doom') : 'Download Freedoom'|t('doom') }}
        </button>
    </div>

    <div class="doom-fetch-progress"></div>

    <p class="doom-fetch-status light"></p>
</div>

<hr>

{{ forms.autosuggestField({
    label: 'WAD path'|t('doom'),
    instructions: 'Load a WAD from somewhere else instead. An absolute path, an @alias, or a $ENVIRONMENT_VARIABLE. Leave this empty to use the first WAD found in {dir}.'|t('doom', {dir: storageDir}),
    id: 'wadPath',
    name: 'wadPath',
    suggestEnvVars: true,
    suggestAliases: true,
    value: settings.wadPath,
    errors: settings.getErrors('wadPath'),
}) }}

<hr>

{{ forms.lightswitchField({
    label: 'Pointer lock'|t('doom'),
    instructions: 'Capture the mouse for mouselook when the canvas is clicked. Turn this off for keyboard-only play.'|t('doom'),
    id: 'pointerLock',
    name: 'pointerLock',
    on: settings.pointerLock,
    errors: settings.getErrors('pointerLock'),
}) }}

{% css %}
    /* Only when it leads the pane. If the engine warning is showing, the
       heading is no longer first and wants its normal spacing back. */
    .doom-heading:first-child { margin-top: 0; }
    .doom-wad-list { margin-top: 8px; }
    .doom-fetch { margin-top: 20px; }
    .doom-fetch .buttons { margin-top: 0; }
    .doom-fetch .doom-fetch-progress { max-width: 380px; }
    .doom-fetch .doom-fetch-status { margin-top: 8px; }
    .doom-fetch .doom-fetch-status:empty { display: none; }
    .doom-fetch .doom-fetch-status.error { color: var(--error-color); }
{% endcss %}

{% js %}
    new Craft.DoomWadDownloader('.doom-fetch');
{% endjs %}
