{# =========================================================================
   WAD downloads
   The Utilities screen's copy of the download buttons.

   Here rather than on the settings screen because Craft renders plugin
   settings through Html::disableInputs() when allowAdminChanges is off, which
   disables every button and discards the screen's JavaScript with it.
   ========================================================================= #}

<h2 class="daemon-utility-heading">{{ 'WADs'|t('daemon') }}</h2>

<p class="light">{{ 'Freedoom is free software and all the engine needs to run. The Doom shareware episode is id Software\'s, redistributable but not free, and is fetched rather than shipped for that reason.'|t('daemon') }}</p>

{# Hooked by class, not id, so the same markup works here and anywhere else
   the settings asset is registered. #}
<div class="daemon-fetch">
    <div class="buttons">
        {# Keyed off storage, which is what these buttons fill, and off the named
           game: with only Doom stored, "is anything stored" would have the
           Freedoom button offering to fetch it again. #}
        <button type="button" class="btn daemon-fetch-btn" data-icon="download"
                data-daemon-action="daemon/wad/shareware"
                data-daemon-game="Doom"
                data-daemon-again-label="{{ 'Re-download Doom'|t('daemon') }}">
            {{ wads.hasShareware() ? 'Re-download Doom'|t('daemon') : 'Download Doom'|t('daemon') }}
        </button>

        <button type="button" class="btn daemon-fetch-btn" data-icon="download"
                data-daemon-action="daemon/wad/freedoom"
                data-daemon-game="Freedoom"
                data-daemon-again-label="{{ 'Re-download Freedoom'|t('daemon') }}">
            {{ wads.hasFreedoom() ? 'Re-download Freedoom'|t('daemon') : 'Download Freedoom'|t('daemon') }}
        </button>
    </div>

    {# One bar and status line for both buttons, which is also what keeps two
       downloads from running at once. #}
    <div class="daemon-fetch-progress"></div>

    <p class="daemon-fetch-status light"></p>
</div>

{# raw, so the link survives. Everything interpolated is either built by
   tag(), which escapes its own text, or escaped on the way in. #}
{% set storageDir = tag('code', {text: wads.getStorageDir()}) %}
{% set settingsLink = tag('a', {
    href: url('settings/plugins/daemon'),
    text: 'settings screen'|t('daemon'),
}) %}

<p class="light daemon-fetch-note">
    {{ 'Both land in {dir}. Names and the default game are on the plugin\'s {link}.'|t('daemon', {
        dir: storageDir,
        link: settingsLink,
    })|raw }}
</p>

{# =========================================================================
   Savegames
   Taking off the server what the Saves menu puts on it.

   One person's own saves, never anybody else's: the id comes from the session
   the same way it does everywhere else the plugin touches a save, so holding
   this utility's permission does not hand you somebody else's game.
   ========================================================================= #}

{% if canDownloadSaves %}
    <hr>

    <h2 class="daemon-utility-heading">{{ 'Savegames'|t('daemon') }}</h2>

    {% if not autosave %}
        <p class="light">
            {{ 'Keeping savegames is turned off, so nothing new is being stored. Anything kept before it was turned off is still here.'|t('daemon') }}
        </p>
    {% endif %}

    {% if games is empty %}
        <p class="light">{{ 'You have no savegames stored. They arrive here when you save from the game\'s own Esc menu.'|t('daemon') }}</p>
    {% else %}
        <p class="light">
            {{ 'Your own saves, in the engine\'s own format and under the engine\'s own filenames, so a download drops straight into a desktop PrBoom. Ten versions of each slot are kept; the newest is the one the game loads.'|t('daemon') }}
        </p>

        <div class="buttons">
            {# An ordinary link, because it is a GET that sends a file: routed
               through Craft's action URL so the controller's permission check
               is the thing standing in front of it. #}
            <a class="btn" data-icon="download" href="{{ actionUrl('daemon/save/download-all') }}">
                {{ 'Download all'|t('daemon') }}
            </a>
        </div>

        <p class="light smalltext daemon-utility-note">
            {{ 'That archive holds the newest version of each slot, filed under its game. Older versions are one at a time, below.'|t('daemon') }}
        </p>

        {% for game in games %}
            <h3 class="daemon-utility-game">
                {{ game.wad.name }}
                <span class="light">({{ game.bytes|filesize }})</span>
            </h3>

            <table class="data fullwidth daemon-saves-table">
                <thead>
                    <tr>
                        <th scope="col">{{ 'Save'|t('daemon') }}</th>
                        <th scope="col">{{ 'Slot'|t('daemon') }}</th>
                        <th scope="col">{{ 'Kept'|t('daemon') }}</th>
                        <th scope="col">{{ 'Size'|t('daemon') }}</th>
                        <th scope="col"><span class="visually-hidden">{{ 'Download'|t('daemon') }}</span></th>
                    </tr>
                </thead>
                <tbody>
                    {% for save in game.saves %}
                        <tr>
                            <th scope="row">{{ save.getLabel() }}</th>
                            <td>{{ save.slot + 1 }}</td>
                            <td>{{ save.savedAt|datetime('short') }}</td>
                            <td>{{ save.size|filesize }}</td>
                            <td class="daemon-saves-download">
                                <a class="btn small" data-icon="download" href="{{ actionUrl('daemon/save/download', {wad: game.wad.key, id: save.id}) }}">
                                    {{ 'Download'|t('daemon') }}
                                </a>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endfor %}
    {% endif %}
{% endif %}

{% css %}
    /* The button and its progress on one row. The bar only takes space while
       there is something to report, so an idle screen is just a button. */
    .daemon-fetch {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 20px;
    }
    /* margin-block, not margin-top: .buttons sets 24px on both sides, and
       zeroing only the top leaves it the tallest thing in the row at 54px.
       align-items: center then centres the bar and the status against that,
       while the buttons themselves sit in the top 30px of it, so the bar
       reads as 12px low. */
    .daemon-fetch .buttons { margin-block: 0; }
    .daemon-fetch .daemon-fetch-progress { display: none; flex: 1 1 160px; max-width: 320px; }
    /* Craft's progress bar is absolutely positioned at 20%/60% of whatever
       container it lands in, which is right for an element index and wrong for
       a flex row: it leaves the flow entirely and sizes itself against the
       pane. Put it back in the flow before giving it a width. */
    .daemon-fetch .daemon-fetch-progress .progressbar {
        position: relative;
        inset-inline-start: 0;
        width: 100%;
        margin: 0;
    }
    .daemon-fetch--busy .daemon-fetch-progress { display: block; }
    .daemon-fetch .daemon-fetch-status { margin: 0; }
    .daemon-fetch .daemon-fetch-status:empty { display: none; }
    .daemon-fetch .daemon-fetch-status.error { color: var(--error-color); }
    .daemon-fetch-note { margin-top: 24px; }

    /* Craft's utility pane opens with no heading, so the first one should not
       push the section down off the top of it. */
    .daemon-utility-heading:first-child { margin-top: 0; }
    /* hr carries its own margin; the heading after it does not need to add to
       it, which is how the second section ends up sitting lower than the first
       started. */
    hr + .daemon-utility-heading { margin-top: 0; }
    .daemon-utility-game { margin-bottom: 8px; }
    .daemon-utility-note { margin-top: 8px; }
    .daemon-saves-table { margin-bottom: 24px; }
    /* The button column takes only what the button needs, so the rest goes to
       the description, which is the part that varies. */
    .daemon-saves-download { width: 1%; white-space: nowrap; text-align: end; }
{% endcss %}

{% js %}
    new Craft.DaemonWadDownloader('.daemon-fetch');
{% endjs %}
